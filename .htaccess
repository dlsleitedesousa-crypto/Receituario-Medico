DirectoryIndex index.html index.php

# Obriga o navegador a conferir a página no servidor, para que cada publicação carregue os scripts novos.
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Link curto do QR Code de validação dos documentos assinados digitalmente.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^v/([a-f0-9]{32})$ api/index.php?action=validar&id=$1 [QSA,L]
</IfModule>
